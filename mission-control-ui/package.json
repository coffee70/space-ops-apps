{
  "name": "mission-control-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:application-loaders": "node scripts/generate-application-loaders.mjs",
    "check:application-loaders": "node scripts/generate-application-loaders.mjs --check",
    "predev": "node scripts/generate-application-loaders.mjs && node scripts/copy-cesium.js",
    "dev": "next dev",
    "prebuild": "node scripts/generate-application-loaders.mjs && node scripts/copy-cesium.js",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run check:application-loaders",
    "lint": "eslint",
    "typegen": "next typegen",
    "pretypecheck": "npm run check:application-loaders && node scripts/prepare-next-typecheck.mjs && npm run typegen",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest:runtime": "npm run check:application-loaders",
    "test:runtime": "tsx --test $(find src/platform src/applications/ai-engineer src/lib \\( -name '*.test.ts' -o -name '*.test.tsx' \\))",
    "validate": "npm run check:application-loaders && npm run lint && npm run typecheck && npm run test:runtime"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.35",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.21",
    "cesium": "^1.139.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.576.0",
    "monaco-editor": "^0.54.0",
    "next": "16.1.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "ai": "^4.0.35",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.0",
    "resium": "^1.19.4",
    "shadcn": "^3.8.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
